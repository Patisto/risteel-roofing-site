{
  "rewrites": [
    {
      "source": "/cms",
      "destination": "/cms/index.html"
    },
    {
      "source": "/cms/",
      "destination": "/cms/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cms/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
