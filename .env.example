PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-this-to-a-long-unique-password
CMS_TOKEN_SECRET=replace-with-a-long-random-secret
# Public API origin, used for uploaded image URLs (for example https://api.example.com)
PUBLIC_BASE_URL=
# Comma-separated frontend origins allowed to call this API
CORS_ORIGIN=https://your-site.example.com
# Set by the VPS deploy script; persistent across releases
UPLOAD_DIR=/srv/risteel/shared/uploads
